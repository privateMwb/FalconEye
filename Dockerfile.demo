# syntax=docker/dockerfile:1

# ============================================================
# FalconEye hosted-demo image
#
# One container that runs the whole demo backend: the real
# falconeye_server, a traffic generator that keeps the metrics
# interesting, and a small read-only front door on a single public
# port ($PORT, 10000 by default, which is what Render expects). The
# dashboard is deployed separately; see docs/DEPLOYMENT.md.
#
# Build and run it locally with:
#
#   docker build -f Dockerfile.demo -t falconeye-demo .
#   docker run --rm -p 10000:10000 \
#       -e ALLOWED_ORIGINS=http://localhost:5173 falconeye-demo
#   scripts/check-demo.sh http://localhost:10000 http://localhost:5173
#
# The FalconHTTP and MiniDatabase sources are committed under
# backend/external/, so no submodule step is needed.
# ============================================================

FROM ubuntu:26.04 AS build

RUN apt-get update && \
    apt-get install -y \
        build-essential \
        ca-certificates \
        cmake \
        && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend ./backend

WORKDIR /app/backend

# FALCONEYE_BUILD_TESTS=OFF: the demo does not need the test binary. BUILD_* switch off
# the vendored libraries' own tests, benchmarks and examples.
RUN cmake -S . -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DFALCONEYE_BUILD_TESTS=OFF \
    -DBUILD_TESTS=OFF \
    -DBUILD_BENCHMARKS=OFF \
    -DBUILD_REGRESSION=OFF \
    -DBUILD_EXAMPLES=OFF

RUN cmake --build build --config Release --target falconeye_server -j$(nproc)


FROM ubuntu:26.04

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        libstdc++6 \
        && \
    rm -rf /var/lib/apt/lists/*

# Node runs the front door and traffic generator (zero npm dependencies). It is copied from
# the official image rather than installed with apt, which would give an old release; the
# base stays Ubuntu because the server binary above is built against its glibc.
COPY --from=node:22-bookworm-slim /usr/local/bin/node /usr/local/bin/node

WORKDIR /app

COPY --from=build /app/backend/build/falconeye_server /app/falconeye_server
COPY scripts/demo-server.mjs /app/scripts/demo-server.mjs

# Run as an unprivileged user. Everything lives in memory, so there is nothing to persist.
RUN useradd --system --no-create-home --shell /usr/sbin/nologin falconeye
USER falconeye

ENV PORT=10000
EXPOSE 10000

CMD ["node", "/app/scripts/demo-server.mjs"]
